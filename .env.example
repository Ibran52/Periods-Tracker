# ==============================================================================
# Veyora — Environment Configuration Template
# Copy this file to .env in root or appropriate subdirectories.
# NEVER commit real credentials or private keys to version control.
# ==============================================================================

# Backend Server Configuration (/server/.env)
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/
MONGODB_NAME=Veyora
JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_hex_64
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Internal ML Service connection
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_API_KEY=your_ml_service_api_key_here

# Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@example.com

# Machine Learning Service (/ml-service/.env)
ML_HOST=127.0.0.1
ML_PORT=8000
ML_API_KEY=your_ml_service_api_key_here
ML_MODEL_DIR=./models

# Frontend Client Configuration (/client/.env)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
