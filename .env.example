# ==============================================================================
# Veyora — Environment Configuration Template
# Copy this file to .env in /server, /client, and /ml-service as appropriate.
# NEVER commit real credentials or private keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration (/server/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
MONGODB_URI=
MONGODB_NAME=Veyora
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=

# Internal ML Service connection (private backend-to-backend communication)
ML_SERVICE_URL=
ML_SERVICE_API_KEY=replace_with_the_same_unique_32_character_key_in_both_services

# Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=

# ------------------------------------------------------------------------------
# Machine Learning Service (/ml-service/.env)
# ------------------------------------------------------------------------------
ML_HOST=
ML_PORT=8000
ML_API_KEY=replace_with_the_same_unique_32_character_key_in_both_services
ML_MODEL_DIR=

# ------------------------------------------------------------------------------
# Frontend Client Configuration (/client/.env)
# Note: Variables prefixed with VITE_ are exposed to the browser.
# DO NOT place private API keys, database secrets, or private tokens here.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
